# Local development configuration. Copy to .env and adjust, or export directly.
# The server reads plain environment variables (no dotenv loader).

PORT=3000
NODE_ENV=development
# Number of trusted proxy hops used to resolve the client address.
# 0 or false disables client identification entirely.
TRUST_PROXY=0

# Origins this proxy is authorized to front (comma separated).
ALLOWED_ORIGINS=https://example.com
# Origins for which CSP / X-Frame-Options / COOP / COEP may be removed.
# STRIP_SECURITY_HEADERS_ORIGINS=https://example.com

# Optional bearer token required in front of the whole proxy.
# PROXY_ACCESS_TOKEN=change-me
# Optional HTTP Basic credentials (browser-native authentication prompt).
# PROXY_ACCESS_USER=operator
# PROXY_ACCESS_PASSWORD=change-me

ENABLE_CORS=true
# PUBLIC_ORIGIN=http://localhost:3000
EXAMPLE_TARGET=https://example.com

# Limits
MAX_BODY_BYTES=10485760
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW_MS=60000

# Upstream connection pool
UPSTREAM_MAX_SOCKETS=32
UPSTREAM_MAX_FREE_SOCKETS=8
UPSTREAM_KEEPALIVE_MS=30000
RETRY_ATTEMPTS=2
RETRY_BASE_DELAY_MS=100

# Cap the V8 heap so the process stays inside a small instance. Set this in
# the environment before starting the server (it is a startup flag).
# NODE_OPTIONS=--max-old-space-size=256

# SSRF containment (set ALLOW_PRIVATE_TARGETS=true for internal origins)
SSRF_GUARD=true
ALLOW_PRIVATE_TARGETS=false

# Signal fidelity
FORWARDED_HEADERS=false
FORWARD_REQUEST_ID=false
OVERRIDE_FINGERPRINT=false
STRIP_ACCEPT_ENCODING=false
ORIGIN_HEADERS_MODE=relay

# Observability
# `warn` avoids a JSON log line per request; `info` logs every request.
LOG_LEVEL=warn
LOG_FORMAT=pretty
SHUTDOWN_GRACE_MS=20000
