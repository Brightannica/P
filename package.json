{
  "name": "proxy",
  "version": "2.0.0",
  "private": true,
  "description": "Production-grade sticky-session reverse proxy with pooled connections, media streaming and WebSocket support, optimized for Render.",
  "main": "server.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node test/integration.js",
    "bench": "node test/benchmark.js",
    "health": "node -e \"fetch('http://127.0.0.1:'+(process.env.PORT||3000)+'/healthz').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))\""
  },
  "dependencies": {
    "express": "^4.19.2",
    "http-proxy-middleware": "^3.0.3"
  },
  "keywords": [
    "reverse-proxy",
    "http-proxy-middleware",
    "render",
    "streaming",
    "websocket"
  ],
  "license": "MIT"
}
